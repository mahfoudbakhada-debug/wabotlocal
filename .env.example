# ============================================
# WABOTLOCAL - Variables de entorno
# Copia este archivo como ".env" y rellena tus datos reales.
# NUNCA subas el archivo ".env" real a un repositorio publico.
# ============================================

# --- Twilio (WhatsApp) ---
# Se obtienen en https://console.twilio.com
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token_de_twilio
# Numero de WhatsApp de Twilio (sandbox o numero comprado), formato: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Google APIs (Calendar + Sheets) ---
# Se obtienen creando una Service Account en Google Cloud Console
# y compartiendo el Calendar y el Sheet con el email de esa cuenta.
GOOGLE_CLIENT_EMAIL=tu-service-account@tu-proyecto.iam.gserviceaccount.com
# IMPORTANTE: mantener los \n literales dentro de las comillas
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# ID de la hoja de Google Sheets donde se guardan las reservas
SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# ID del calendario de Google donde se crean las citas (email del calendario o "primary")
CALENDAR_ID=primary

# --- Panel de administracion ---
ADMIN_USER=admin
ADMIN_PASS=cambia_esta_password

# --- Servidor ---
PORT=3000

# --- Cron de resenas ---
# Zona horaria para que el cron corra a las 10:00 hora local
CRON_TIMEZONE=Europe/Madrid
